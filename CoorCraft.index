<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="CoorCraft - Bloc de Notas de Coordenadas Moderno">
    <meta name="theme-color" content="#3b82f6">
    <title>CoorCraft - Gestor de Coordenadas</title>
    <style>
        /* ============================================
           VARIABLES Y TEMAS
           ============================================ */
        :root {
            --bg-primary: #f8fafc;
            --bg-secondary: #e2e8f0;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --accent: #3b82f6;
            --accent-hover: #2563eb;
            --border: #cbd5e1;
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
            --shadow-lg: 0 20px 40px rgba(0, 0, 0, 0.12);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --cursor-color: #3b82f6;
        }

        @media (prefers-color-scheme: dark) {
            :root.theme-dark,
            :root:not(.theme-light) {
                --bg-primary: #0b0f19;
                --bg-secondary: #1e293b;
                --text-primary: #e2e8f0;
                --text-secondary: #cbd5e1;
                --accent: #60a5fa;
                --accent-hover: #3b82f6;
                --border: #334155;
                --shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
                --shadow-lg: 0 20px 40px rgba(0, 0, 0, 0.5);
            }
        }

        :root.theme-dark {
            --bg-primary: #0b0f19;
            --bg-secondary: #1e293b;
            --text-primary: #e2e8f0;
            --text-secondary: #cbd5e1;
            --accent: #60a5fa;
            --accent-hover: #3b82f6;
            --border: #334155;
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
            --shadow-lg: 0 20px 40px rgba(0, 0, 0, 0.5);
        }

        /* ============================================
           RESET Y BASE
           ============================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            font-size: 16px;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            transition: var(--transition);
            line-height: 1.6;
            overflow-x: hidden;
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }

        /* Cursor personalizado solo en PC */
        @media (hover: hover) and (pointer: fine) {
            body {
                cursor: none;
            }
        }

        /* ============================================
           LAYOUT PRINCIPAL Y CONTENEDOR
           ============================================ */
        .app-container {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            perspective: 1200px;
        }

        header {
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
            border-bottom: 1px solid var(--border);
            padding: 1.5rem 1rem;
            backdrop-filter: blur(12px);
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .logo {
            font-size: 1.5em;
            font-weight: 700;
            background: linear-gradient(135deg, var(--accent), var(--accent-hover));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -0.5px;
        }

        .search-bar {
            flex: 1;
            max-width: 400px;
            position: relative;
        }

        .search-bar input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--border);
            background: var(--bg-primary);
            color: var(--text-primary);
            border-radius: 16px;
            font-size: 0.95em;
            transition: var(--transition);
            font-family: inherit;
        }

        .search-bar input:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .search-bar input::placeholder {
            color: var(--text-secondary);
        }

        .header-actions {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        /* ============================================
           BOTONES Y CONTROLES
           ============================================ */
        button {
            font-family: inherit;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            border-radius: 12px;
            font-size: 0.95em;
            font-weight: 500;
        }

        .btn-primary {
            background: var(--accent);
            color: white;
            padding: 0.75rem 1.5rem;
            box-shadow: var(--shadow);
        }

        .btn-primary:hover {
            background: var(--accent-hover);
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .btn-primary:active {
            transform: scale(0.98);
        }

        .btn-icon {
            background: var(--bg-secondary);
            color: var(--text-primary);
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            font-size: 1.2em;
            box-shadow: var(--shadow);
        }

        .btn-icon:hover {
            background: var(--border);
            transform: scale(1.05);
        }

        .btn-secondary {
            background: var(--bg-secondary);
            color: var(--text-primary);
            padding: 0.75rem 1.5rem;
            border: 1px solid var(--border);
        }

        .btn-secondary:hover {
            background: var(--border);
        }

        .btn-danger {
            background: #ef4444;
            color: white;
            padding: 0.5rem 1rem;
            font-size: 0.85em;
        }

        .btn-danger:hover {
            background: #dc2626;
        }

        .btn-small {
            padding: 0.5rem 1rem;
            font-size: 0.85em;
        }

        /* ============================================
           CONTENIDO PRINCIPAL
           ============================================ */
        main {
            flex: 1;
            max-width: 1200px;
            width: 100%;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .empty-state {
            text-align: center;
            padding: 4rem 1rem;
            color: var(--text-secondary);
        }

        .empty-state svg {
            width: 80px;
            height: 80px;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        .empty-state p {
            font-size: 1.1em;
            margin-bottom: 1.5rem;
        }

        /* ============================================
           GRID DE NOTAS
           ============================================ */
        .notes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
            animation: fadeIn 0.4s ease-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        .note-card {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: var(--shadow);
            transition: var(--transition);
            cursor: pointer;
            transform-style: preserve-3d;
            position: relative;
            overflow: hidden;
        }

        .note-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, transparent, rgba(255, 255, 255, 0.1));
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .note-card:hover::before {
            opacity: 1;
        }

        .note-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
            border-color: var(--accent);
        }

        .note-title {
            font-size: 1.2em;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
            word-break: break-word;
        }

        .note-coordinates {
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
            color: var(--accent);
            background: rgba(59, 130, 246, 0.05);
            padding: 0.75rem;
            border-radius: 8px;
            margin: 0.75rem 0;
            word-break: break-all;
            line-height: 1.5;
        }

        .note-timestamp {
            font-size: 0.8em;
            color: var(--text-secondary);
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--border);
        }

        .timestamp-label {
            display: block;
            font-weight: 500;
            margin-bottom: 0.25rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .timestamp-value {
            font-family: 'Courier New', monospace;
            font-weight: 600;
        }

        .note-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--border);
        }

        .note-actions button {
            flex: 1;
            padding: 0.5rem;
            font-size: 0.85em;
        }

        .badge-updated {
            display: inline-block;
            background: #10b981;
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 8px;
            font-size: 0.75em;
            margin-top: 0.5rem;
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-10px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* ============================================
           MODALES Y FORMULARIOS
           ============================================ */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            animation: fadeInOverlay 0.2s ease-out;
        }

        .modal-overlay.active {
            display: flex;
        }

        @keyframes fadeInOverlay {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        .modal-content {
            background: var(--bg-primary);
            border-radius: 20px;
            padding: 2rem;
            max-width: 500px;
            width: 90%;
            box-shadow: var(--shadow-lg);
            animation: slideUpModal 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid var(--border);
        }

        @keyframes slideUpModal {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .modal-header h2 {
            font-size: 1.3em;
            color: var(--text-primary);
        }

        .btn-close {
            background: none;
            font-size: 1.5em;
            color: var(--text-secondary);
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }

        .btn-close:hover {
            color: var(--text-primary);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            color: var(--text-primary);
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--border);
            background: var(--bg-secondary);
            color: var(--text-primary);
            border-radius: 12px;
            font-family: inherit;
            font-size: 0.95em;
            transition: var(--transition);
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 120px;
            font-family: 'Courier New', monospace;
        }

        .modal-actions {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }

        .modal-actions button {
            flex: 1;
        }

        /* ============================================
           PANEL DE CONFIGURACIÓN
           ============================================ */
        .settings-panel {
            position: fixed;
            right: -400px;
            top: 0;
            width: 400px;
            height: 100vh;
            background: var(--bg-primary);
            border-left: 1px solid var(--border);
            box-shadow: -4px 0 20px rgba(0, 0, 0, 0.1);
            overflow-y: auto;
            transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 999;
            backdrop-filter: blur(12px);
        }

        .settings-panel.active {
            right: 0;
        }

        .settings-content {
            padding: 2rem 1.5rem;
        }

        .settings-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border);
        }

        .settings-header h2 {
            font-size: 1.3em;
        }

        .settings-section {
            margin-bottom: 2rem;
        }

        .settings-section h3 {
            font-size: 0.95em;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-secondary);
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .settings-option {
            margin-bottom: 1.2rem;
        }

        .settings-option label {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            padding: 0.75rem;
            border-radius: 12px;
            transition: var(--transition);
        }

        .settings-option label:hover {
            background: var(--bg-secondary);
        }

        .settings-option input[type="radio"],
        .settings-option input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .color-picker-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.75rem;
        }

        .color-option {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            border: 2px solid transparent;
            cursor: pointer;
            transition: var(--transition);
        }

        .color-option:hover {
            transform: scale(1.1);
        }

        .color-option.active {
            border-color: var(--text-primary);
            box-shadow: 0 0 0 3px var(--bg-secondary);
        }

        .color-native-picker {
            width: 60px;
            height: 50px;
            border: none;
            border-radius: 12px;
            cursor: pointer;
        }

        .storage-info {
            background: var(--bg-secondary);
            padding: 1rem;
            border-radius: 12px;
            font-size: 0.9em;
            color: var(--text-secondary);
            margin-top: 1rem;
        }

        .storage-bar {
            width: 100%;
            height: 8px;
            background: var(--border);
            border-radius: 4px;
            margin-top: 0.5rem;
            overflow: hidden;
        }

        .storage-used {
            height: 100%;
            background: linear-gradient(90deg, var(--accent), var(--accent-hover));
            transition: width 0.3s ease-out;
        }

        .footer {
            text-align: center;
            padding: 1.5rem;
            color: var(--text-secondary);
            font-size: 0.85em;
            border-top: 1px solid var(--border);
            margin-top: auto;
        }

        .footer a {
            color: var(--accent);
            text-decoration: none;
            transition: var(--transition);
        }

        .footer a:hover {
            text-decoration: underline;
        }

        /* ============================================
           CURSOR PERSONALIZADO
           ============================================ */
        .custom-cursor {
            position: fixed;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            pointer-events: none;
            z-index: 9999;
            background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.4), transparent);
            border: 2px solid var(--cursor-color);
            box-shadow: 0 0 8px var(--cursor-color), inset 0 0 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.1s ease-out, opacity 0.2s ease-out;
            opacity: 0.9;
            display: none;
        }

        @media (hover: hover) and (pointer: fine) {
            .custom-cursor {
                display: block;
            }
        }

        .custom-cursor.active {
            transform: scale(1.3);
            opacity: 1;
        }

        .custom-cursor.clicking {
            transform: scale(0.8);
            opacity: 0.8;
        }

        /* ============================================
           NOTIFICACIONES
           ============================================ */
        .toast {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background: var(--accent);
            color: white;
            padding: 1rem 1.5rem;
            border-radius: 12px;
            box-shadow: var(--shadow-lg);
            animation: slideInToast 0.3s ease-out;
            z-index: 1001;
            max-width: 300px;
        }

        @keyframes slideInToast {
            from {
                opacity: 0;
                transform: translateX(20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .toast.error {
            background: #ef4444;
        }

        .toast.success {
            background: #10b981;
        }

        /* ============================================
           RESPONSIVO
           ============================================ */
        @media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                gap: 1rem;
            }

            .search-bar {
                max-width: 100%;
            }

            .notes-grid {
                grid-template-columns: 1fr;
            }

            .settings-panel {
                width: 100%;
                right: -100%;
            }

            main {
                margin: 1rem auto;
            }

            .modal-content {
                padding: 1.5rem;
            }

            .toast {
                left: 1rem;
                right: 1rem;
                bottom: 1rem;
            }
        }

        @media (max-width: 480px) {
            html {
                font-size: 14px;
            }

            .logo {
                font-size: 1.2em;
            }

            header {
                padding: 1rem;
            }

            .btn-icon {
                width: 40px;
                height: 40px;
                font-size: 1em;
            }

            .note-card {
                padding: 1rem;
            }

            .modal-content {
                width: 95%;
            }
        }
    </style>
</head>
<body>
    <!-- Cursor Personalizado -->
    <div class="custom-cursor"></div>

    <!-- Contenedor Principal -->
    <div class="app-container">
        <!-- Header -->
        <header>
            <div class="header-content">
                <div class="logo">📍 CoorCraft</div>
                <div class="search-bar">
                    <input 
                        type="text" 
                        id="searchInput" 
                        placeholder="Buscar notas..." 
                        aria-label="Buscar notas"
                    >
                </div>
                <div class="header-actions">
                    <button 
                        class="btn-primary" 
                        id="addNoteBtn" 
                        aria-label="Agregar nueva nota"
                    >
                        + Nueva
                    </button>
                    <button 
                        class="btn-icon" 
                        id="settingsBtn" 
                        aria-label="Abrir configuración"
                    >
                        ⚙️
                    </button>
                </div>
            </div>
        </header>

        <!-- Contenido Principal -->
        <main>
            <div class="notes-grid" id="notesGrid">
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2v20M2 12h20"></path>
                    </svg>
                    <p id="emptyMessage">No hay notas aún. ¡Crea una nueva!</p>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="footer">
            <p>Desarrollado por <strong>King Remux</strong> • 2026</p>
        </footer>
    </div>

    <!-- Modal Agregar/Editar Nota -->
    <div class="modal-overlay" id="noteModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Nueva Nota</h2>
                <button class="btn-close" aria-label="Cerrar modal">&times;</button>
            </div>
            <form id="noteForm">
                <div class="form-group">
                    <label for="noteTitleInput">Título</label>
                    <input 
                        type="text" 
                        id="noteTitleInput" 
                        required 
                        placeholder="Ej: Mi Ubicación"
                        maxlength="100"
                    >
                </div>
                <div class="form-group">
                    <label for="noteCoordinatesInput">Coordenadas</label>
                    <textarea 
                        id="noteCoordinatesInput" 
                        required 
                        placeholder="Ej: 40.7128°N, 74.0060°W o cualquier dato de ubicación"
                    ></textarea>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-secondary" id="cancelNoteBtn">Cancelar</button>
                    <button type="submit" class="btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Panel de Configuración -->
    <div class="settings-panel" id="settingsPanel">
        <div class="settings-content">
            <div class="settings-header">
                <h2 id="settingsTitle">Configuración</h2>
                <button class="btn-close" id="closeSettingsBtn" aria-label="Cerrar configuración">&times;</button>
            </div>

            <!-- Idioma -->
            <div class="settings-section">
                <h3 id="languageLabel">Idioma</h3>
                <div class="settings-option">
                    <label>
                        <input type="radio" name="language" value="es" checked>
                        Español
                    </label>
                </div>
                <div class="settings-option">
                    <label>
                        <input type="radio" name="language" value="en">
                        English
                    </label>
                </div>
                <div class="settings-option">
                    <label>
                        <input type="radio" name="language" value="fr">
                        Français
                    </label>
                </div>
            </div>

            <!-- Tema -->
            <div class="settings-section">
                <h3 id="themeLabel">Tema</h3>
                <div class="settings-option">
                    <label>
                        <input type="radio" name="theme" value="system" checked>
                        <span id="systemTheme">Sistema</span>
                    </label>
                </div>
                <div class="settings-option">
                    <label>
                        <input type="radio" name="theme" value="light">
                        <span id="lightTheme">Claro</span>
                    </label>
                </div>
                <div class="settings-option">
                    <label>
                        <input type="radio" name="theme" value="dark">
                        <span id="darkTheme">Oscuro</span>
                    </label>
                </div>
            </div>

            <!-- Color del Cursor -->
            <div class="settings-section">
                <h3 id="cursorLabel">Color del Cursor</h3>
                <div class="color-picker-grid" id="colorGrid"></div>
                <div style="margin-top: 1rem;">
                    <label for="customColorPicker" id="customColorLabel">Color Personalizado:</label>
                    <input type="color" id="customColorPicker" class="color-native-picker">
                </div>
            </div>

            <!-- Información de Almacenamiento -->
            <div class="settings-section">
                <h3 id="storageLabel">Almacenamiento</h3>
                <div class="storage-info">
                    <div id="storageText">Usado: 0 KB / 5 MB</div>
                    <div class="storage-bar">
                        <div class="storage-used" id="storageBar" style="width: 0%;"></div>
                    </div>
                </div>
            </div>

            <!-- Botón Limpiar Datos -->
            <div class="settings-section">
                <button class="btn-danger" id="clearDataBtn" style="width: 100%;">
                    <span id="clearDataLabel">Limpiar Todos los Datos</span>
                </button>
            </div>
        </div>
    </div>

    <script>
        /* ============================================
           CONFIGURACIÓN I18N Y STRINGS
           ============================================ */
        const i18n = {
            es: {
                addNote: '+ Nueva',
                settings: 'Configuración',
                newNote: 'Nueva Nota',
                editNote: 'Editar Nota',
                title: 'Título',
                coordinates: 'Coordenadas',
                cancel: 'Cancelar',
                save: 'Guardar',
                delete: 'Eliminar',
                edit: 'Editar',
                close: 'Cerrar',
                search: 'Buscar notas...',
                empty: 'No hay notas aún. ¡Crea una nueva!',
                updated: 'Actualizado',
                saved: 'Nota guardada exitosamente',
                deleted: 'Nota eliminada',
                error: 'Error al procesar la solicitud',
                storageFull: 'Almacenamiento casi lleno',
                clearData: 'Limpiar Todos los Datos',
                clearConfirm: '¿Estás seguro? Esta acción no se puede deshacer.',
                language: 'Idioma',
                theme: 'Tema',
                system: 'Sistema',
                light: 'Claro',
                dark: 'Oscuro',
                cursor: 'Color del Cursor',
                storage: 'Almacenamiento',
                created: 'Creado:',
                edited: 'Editado:',
                customColor: 'Color Personalizado:',
            },
            en: {
                addNote: '+ New',
                settings: 'Settings',
                newNote: 'New Note',
                editNote: 'Edit Note',
                title: 'Title',
                coordinates: 'Coordinates',
                cancel: 'Cancel',
                save: 'Save',
                delete: 'Delete',
                edit: 'Edit',
                close: 'Close',
                search: 'Search notes...',
                empty: 'No notes yet. Create one!',
                updated: 'Updated',
                saved: 'Note saved successfully',
                deleted: 'Note deleted',
                error: 'Error processing request',
                storageFull: 'Storage almost full',
                clearData: 'Clear All Data',
                clearConfirm: 'Are you sure? This action cannot be undone.',
                language: 'Language',
                theme: 'Theme',
                system: 'System',
                light: 'Light',
                dark: 'Dark',
                cursor: 'Cursor Color',
                storage: 'Storage',
                created: 'Created:',
                edited: 'Edited:',
                customColor: 'Custom Color:',
            },
            fr: {
                addNote: '+ Nouveau',
                settings: 'Paramètres',
                newNote: 'Nouvelle Note',
                editNote: 'Modifier la Note',
                title: 'Titre',
                coordinates: 'Coordonnées',
                cancel: 'Annuler',
                save: 'Enregistrer',
                delete: 'Supprimer',
                edit: 'Modifier',
                close: 'Fermer',
                search: 'Rechercher des notes...',
                empty: 'Pas de notes pour le moment. Créez-en une!',
                updated: 'Mise à jour',
                saved: 'Note enregistrée avec succès',
                deleted: 'Note supprimée',
                error: 'Erreur lors du traitement',
                storageFull: 'Stockage presque plein',
                clearData: 'Effacer Toutes les Données',
                clearConfirm: 'Êtes-vous sûr? Cette action est irréversible.',
                language: 'Langue',
                theme: 'Thème',
                system: 'Système',
                light: 'Clair',
                dark: 'Sombre',
                cursor: 'Couleur du Curseur',
                storage: 'Stockage',
                created: 'Créé:',
                edited: 'Modifié:',
                customColor: 'Couleur Personnalisée:',
            },
        };

        const colorPalette = [
            '#3b82f6', '#60a5fa', '#06b6d4', '#10b981',
            '#f59e0b', '#ef4444', '#ec4899', '#8b5cf6'
        ];

        /* ============================================
           ESTADO GLOBAL
           ============================================ */
        let appState = {
            notes: [],
            currentLang: 'es',
            currentTheme: 'system',
            currentCursorColor: '#3b82f6',
            editingNoteId: null,
        };

        /* ============================================
           UTILIDADES
           ============================================ */
        const Utils = {
            getLocalizedString(key) {
                return i18n[appState.currentLang][key] || key;
            },

            formatTimestamp() {
                const now = new Date();
                const day = String(now.getDate()).padStart(2, '0');
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const year = now.getFullYear();
                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                const seconds = String(now.getSeconds()).padStart(2, '0');
                return `${day}/${month}/${year} ${hours}:${minutes}:${seconds}`;
            },

            generateId() {
                return Date.now().toString(36) + Math.random().toString(36).substr(2);
            },

            getStorageUsage() {
                let usage = 0;
                try {
                    const data = JSON.stringify(appState.notes);
                    usage = new Blob([data]).size;
                } catch (e) {
                    console.error('Storage check error', e);
                }
                return usage;
            },

            debounce(func, delay) {
                let timeoutId;
                return function (...args) {
                    clearTimeout(timeoutId);
                    timeoutId = setTimeout(() => func.apply(this, args), delay);
                };
            },

            showToast(message, type = 'success') {
                const toast = document.createElement('div');
                toast.className = `toast ${type}`;
                toast.textContent = message;
                document.body.appendChild(toast);

                setTimeout(() => {
                    toast.remove();
                }, 3000);
            },
        };

        /* ============================================
           GESTIÓN DE ALMACENAMIENTO
           ============================================ */
        const Storage = {
            save() {
                try {
                    localStorage.setItem('coorcraft_notes', JSON.stringify(appState.notes));
                    localStorage.setItem('coorcraft_lang', appState.currentLang);
                    localStorage.setItem('coorcraft_theme', appState.currentTheme);
                    localStorage.setItem('coorcraft_cursor', appState.currentCursorColor);
                } catch (e) {
                    if (e.name === 'QuotaExceededError') {
                        Utils.showToast(Utils.getLocalizedString('storageFull'), 'error');
                    }
                }
            },

            load() {
                try {
                    const notes = localStorage.getItem('coorcraft_notes');
                    const lang = localStorage.getItem('coorcraft_lang');
                    const theme = localStorage.getItem('coorcraft_theme');
                    const cursor = localStorage.getItem('coorcraft_cursor');

                    if (notes) appState.notes = JSON.parse(notes);
                    if (lang) appState.currentLang = lang;
                    if (theme) appState.currentTheme = theme;
                    if (cursor) appState.currentCursorColor = cursor;
                } catch (e) {
                    console.error('Load error', e);
                }
            },

            clear() {
                if (confirm(Utils.getLocalizedString('clearConfirm'))) {
                    appState.notes = [];
                    localStorage.clear();
                    UI.render();
                    Utils.showToast(Utils.getLocalizedString('deleted'));
                }
            },
        };

        /* ============================================
           GESTIÓN DE NOTAS
           ============================================ */
        const Notes = {
            create(title, coordinates) {
                const note = {
                    id: Utils.generateId(),
                    title,
                    coordinates,
                    createdAt: Utils.formatTimestamp(),
                    updatedAt: Utils.formatTimestamp(),
                    isNew: true,
                };
                appState.notes.unshift(note);
                Storage.save();
                return note;
            },

            update(id, title, coordinates) {
                const note = appState.notes.find(n => n.id === id);
                if (note) {
                    note.title = title;
                    note.coordinates = coordinates;
                    note.updatedAt = Utils.formatTimestamp();
                    note.isNew = false;
                    Storage.save();
                }
            },

            delete(id) {
                appState.notes = appState.notes.filter(n => n.id !== id);
                Storage.save();
            },

            search(query) {
                const q = query.toLowerCase();
                return appState.notes.filter(note =>
                    note.title.toLowerCase().includes(q) ||
                    note.coordinates.toLowerCase().includes(q)
                );
            },
        };

        /* ============================================
           INTERFAZ DE USUARIO
           ============================================ */
        const UI = {
            render() {
                const grid = document.getElementById('notesGrid');
                const searchQuery = document.getElementById('searchInput').value;
                const notesToRender = searchQuery ? Notes.search(searchQuery) : appState.notes;

                if (notesToRender.length === 0) {
                    grid.innerHTML = `
                        <div class="empty-state">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2v20M2 12h20"></path>
                            </svg>
                            <p>${Utils.getLocalizedString('empty')}</p>
                        </div>
                    `;
                    return;
                }

                grid.innerHTML = notesToRender.map(note => `
                    <div class="note-card" data-id="${note.id}">
                        <div class="note-title">${this.escapeHtml(note.title)}</div>
                        <div class="note-coordinates">${this.escapeHtml(note.coordinates)}</div>
                        <div class="note-timestamp">
                            <span class="timestamp-label">${Utils.getLocalizedString('created')}</span>
                            <span class="timestamp-value">${note.createdAt}</span>
                            ${note.updatedAt !== note.createdAt ? `
                                <br>
                                <span class="timestamp-label">${Utils.getLocalizedString('edited')}</span>
                                <span class="timestamp-value">${note.updatedAt}</span>
                            ` : ''}
                            ${!note.isNew ? `<span class="badge-updated">${Utils.getLocalizedString('updated')}</span>` : ''}
                        </div>
                        <div class="note-actions">
                            <button class="btn-secondary btn-small edit-btn" data-id="${note.id}">
                                ${Utils.getLocalizedString('edit')}
                            </button>
                            <button class="btn-danger btn-small delete-btn" data-id="${note.id}">
                                ${Utils.getLocalizedString('delete')}
                            </button>
                        </div>
                    </div>
                `).join('');

                this.attachNoteListeners();
            },

            escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            },

            attachNoteListeners() {
                document.querySelectorAll('.edit-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const id = btn.dataset.id;
                        const note = appState.notes.find(n => n.id === id);
                        this.openNoteModal(note);
                    });
                });

                document.querySelectorAll('.delete-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const id = btn.dataset.id;
                        Notes.delete(id);
                        this.render();
                        Utils.showToast(Utils.getLocalizedString('deleted'));
                    });
                });
            },

            openNoteModal(note = null) {
                const modal = document.getElementById('noteModal');
                const titleInput = document.getElementById('noteTitleInput');
                const coordinatesInput = document.getElementById('noteCoordinatesInput');
                const modalTitle = document.getElementById('modalTitle');

                appState.editingNoteId = note ? note.id : null;

                if (note) {
                    modalTitle.textContent = Utils.getLocalizedString('editNote');
                    titleInput.value = note.title;
                    coordinatesInput.value = note.coordinates;
                } else {
                    modalTitle.textContent = Utils.getLocalizedString('newNote');
                    titleInput.value = '';
                    coordinatesInput.value = '';
                }

                modal.classList.add('active');
                titleInput.focus();
            },

            closeNoteModal() {
                const modal = document.getElementById('noteModal');
                modal.classList.remove('active');
                appState.editingNoteId = null;
            },

            toggleSettingsPanel() {
                const panel = document.getElementById('settingsPanel');
                panel.classList.toggle('active');
            },

            closeSettingsPanel() {
                const panel = document.getElementById('settingsPanel');
                panel.classList.remove('active');
            },

            updateStorageInfo() {
                const usage = Utils.getStorageUsage();
                const limit = 5 * 1024 * 1024;
                const percentage = (usage / limit) * 100;

                const storageText = document.getElementById('storageText');
                const storageBar = document.getElementById('storageBar');

                storageText.textContent = `Usado: ${(usage / 1024).toFixed(1)} KB / 5 MB`;
                storageBar.style.width = `${Math.min(percentage, 100)}%`;
            },

            updateLanguage(lang) {
                appState.currentLang = lang;
                Storage.save();
                this.updateUI();
            },

            updateTheme(theme) {
                appState.currentTheme = theme;
                this.applyTheme(theme);
                Storage.save();
            },

            applyTheme(theme) {
                const html = document.documentElement;
                if (theme === 'dark') {
                    html.classList.add('theme-dark');
                    html.classList.remove('theme-light');
                } else if (theme === 'light') {
                    html.classList.add('theme-light');
                    html.classList.remove('theme-dark');
                } else {
                    html.classList.remove('theme-dark', 'theme-light');
                }
            },

            updateCursorColor(color) {
                appState.currentCursorColor = color;
                document.documentElement.style.setProperty('--cursor-color', color);
                Storage.save();
            },

            updateUI() {
                // Actualizar textos de UI según idioma
                document.getElementById('addNoteBtn').textContent = Utils.getLocalizedString('addNote');
                document.getElementById('searchInput').placeholder = Utils.getLocalizedString('search');
                document.getElementById('emptyMessage').textContent = Utils.getLocalizedString('empty');

                // Actualizar modal
                const submitBtn = document.querySelector('#noteForm button[type="submit"]');
                const cancelBtn = document.getElementById('cancelNoteBtn');
                if (submitBtn) submitBtn.textContent = Utils.getLocalizedString('save');
                if (cancelBtn) cancelBtn.textContent = Utils.getLocalizedString('cancel');

                // Actualizar settings
                document.getElementById('settingsTitle').textContent = Utils.getLocalizedString('settings');
                document.getElementById('languageLabel').textContent = Utils.getLocalizedString('language');
                document.getElementById('themeLabel').textContent = Utils.getLocalizedString('theme');
                document.getElementById('systemTheme').textContent = Utils.getLocalizedString('system');
                document.getElementById('lightTheme').textContent = Utils.getLocalizedString('light');
                document.getElementById('darkTheme').textContent = Utils.getLocalizedString('dark');
                document.getElementById('cursorLabel').textContent = Utils.getLocalizedString('cursor');
                document.getElementById('storageLabel').textContent = Utils.getLocalizedString('storage');
                document.getElementById('clearDataLabel').textContent = Utils.getLocalizedString('clearData');
                document.getElementById('customColorLabel').textContent = Utils.getLocalizedString('customColor');

                this.render();
            },

            initializeColorPicker() {
                const grid = document.getElementById('colorGrid');
                grid.innerHTML = colorPalette.map(color => `
                    <div 
                        class="color-option ${color === appState.currentCursorColor ? 'active' : ''}" 
                        style="background-color: ${color}"
                        data-color="${color}"
                    ></div>
                `).join('');

                grid.querySelectorAll('.color-option').forEach(option => {
                    option.addEventListener('click', () => {
                        const color = option.dataset.color;
                        this.updateCursorColor(color);
                        this.initializeColorPicker();
                    });
                });

                const customPicker = document.getElementById('customColorPicker');
                customPicker.value = appState.currentCursorColor;
                customPicker.addEventListener('change', (e) => {
                    this.updateCursorColor(e.target.value);
                    this.initializeColorPicker();
                });
            },
        };

        /* ============================================
           CURSOR PERSONALIZADO
           ============================================ */
        const CustomCursor = {
            cursor: null,
            isVisible: false,

            init() {
                this.cursor = document.querySelector('.custom-cursor');
                
                if (!('ontouchstart' in window) && window.matchMedia('(hover: hover)').matches) {
                    document.addEventListener('mousemove', (e) => this.move(e));
                    document.addEventListener('mouseenter', () => this.show());
                    document.addEventListener('mouseleave', () => this.hide());
                    document.addEventListener('mousedown', () => this.click());
                    document.addEventListener('mouseup', () => this.release());
                }
            },

            move(e) {
                if (!this.isVisible) this.show();
                this.cursor.style.left = e.clientX - 12 + 'px';
                this.cursor.style.top = e.clientY - 12 + 'px';

                const target = e.target;
                if (target.tagName === 'BUTTON' || target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.classList.contains('note-card')) {
                    this.cursor.classList.add('active');
                } else {
                    this.cursor.classList.remove('active');
                }
            },

            show() {
                this.isVisible = true;
                this.cursor.style.opacity = '0.9';
            },

            hide() {
                this.isVisible = false;
                this.cursor.style.opacity = '0';
            },

            click() {
                this.cursor.classList.add('clicking');
            },

            release() {
                this.cursor.classList.remove('clicking');
            },
        };

        /* ============================================
           INICIALIZACIÓN Y EVENT LISTENERS
           ============================================ */
        document.addEventListener('DOMContentLoaded', () => {
            // Cargar datos persistidos
            Storage.load();
            UI.applyTheme(appState.currentTheme);
            UI.updateCursorColor(appState.currentCursorColor);

            // Renderizar UI
            UI.updateUI();
            UI.initializeColorPicker();
            UI.updateStorageInfo();
            CustomCursor.init();

            // Event listeners - Botones principales
            document.getElementById('addNoteBtn').addEventListener('click', () => {
                UI.openNoteModal();
            });

            document.getElementById('settingsBtn').addEventListener('click', () => {
                UI.toggleSettingsPanel();
            });

            // Event listeners - Modal de notas
            const noteModal = document.getElementById('noteModal');
            const noteForm = document.getElementById('noteForm');
            const closeModalBtn = noteModal.querySelector('.btn-close');
            const cancelNoteBtn = document.getElementById('cancelNoteBtn');

            noteForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const title = document.getElementById('noteTitleInput').value.trim();
                const coordinates = document.getElementById('noteCoordinatesInput').value.trim();

                if (!title || !coordinates) {
                    Utils.showToast(Utils.getLocalizedString('error'), 'error');
                    return;
                }

                if (appState.editingNoteId) {
                    Notes.update(appState.editingNoteId, title, coordinates);
                } else {
                    Notes.create(title, coordinates);
                }

                UI.render();
                UI.closeNoteModal();
                Utils.showToast(Utils.getLocalizedString('saved'));
                UI.updateStorageInfo();
            });

            closeModalBtn.addEventListener('click', () => UI.closeNoteModal());
            cancelNoteBtn.addEventListener('click', () => UI.closeNoteModal());

            noteModal.addEventListener('click', (e) => {
                if (e.target === noteModal) UI.closeNoteModal();
            });

            // Event listeners - Búsqueda (con debounce)
            const searchInput = document.getElementById('searchInput');
            searchInput.addEventListener('input', Utils.debounce(() => {
                UI.render();
            }, 300));

            // Event listeners - Settings
            const closeSettingsBtn = document.getElementById('closeSettingsBtn');
            closeSettingsBtn.addEventListener('click', () => UI.closeSettingsPanel());

            document.querySelectorAll('input[name="language"]').forEach(radio => {
                radio.checked = radio.value === appState.currentLang;
                radio.addEventListener('change', (e) => {
                    UI.updateLanguage(e.target.value);
                    UI.initializeColorPicker();
                });
            });

            document.querySelectorAll('input[name="theme"]').forEach(radio => {
                radio.checked = radio.value === appState.currentTheme;
                radio.addEventListener('change', (e) => {
                    UI.updateTheme(e.target.value);
                });
            });

            document.getElementById('clearDataBtn').addEventListener('click', () => {
                Storage.clear();
            });

            // Cerrar settings al hacer clic fuera
            document.addEventListener('click', (e) => {
                const settingsPanel = document.getElementById('settingsPanel');
                const settingsBtn = document.getElementById('settingsBtn');
                if (!settingsPanel.contains(e.target) && !settingsBtn.contains(e.target)) {
                    if (settingsPanel.classList.contains('active')) {
                        UI.closeSettingsPanel();
                    }
                }
            });

            // Actualizar almacenamiento cada vez que se renderiza
            const originalRender = UI.render.bind(UI);
            UI.render = function() {
                originalRender();
                UI.updateStorageInfo();
            };
        });

        // Detectar cambios en tema del sistema
        if (window.matchMedia) {
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
                if (appState.currentTheme === 'system') {
                    UI.applyTheme('system');
                }
            });
        }
    </script>
</body>
</html>